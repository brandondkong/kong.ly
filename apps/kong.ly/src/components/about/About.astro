---
import Reveal from '../common/Reveal.astro';
import Section from '../common/Section.astro';
import Text from '../common/Text.astro';
---

<Section
    hideBorder
    title="About"
    buttonText="View Photos"
    href="/photos"
    class="gap-section-gap flex flex-col"
>
    <Reveal class="gap-section-gap flex flex-col">
        <Text variant="body-lg" class="max-w-2xl text-justify">
            I build products from the ground up for startups,
            niche developer tools, and systems that last!
            I&apos;m always trying to improve my understanding of computers
            and hardware, finding ways to shave off nanoseconds from code
            execution.
        </Text>

        <Text variant="body-lg" class="ml-auto max-w-2xl text-justify">
            In my free time, I relish taking typing tests, playing (and
            ultimately losing in) chess, traveling, and taking photos.
        </Text>
    </Reveal>
</Section>
