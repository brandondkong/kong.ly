---
import Reveal from '../common/Reveal.astro';
import Section from '../common/Section.astro';
import Text from '../common/Text.astro';
---

<Section
    title="About"
    href="/about"
    buttonText="Show More"
    class="gap-section-gap flex flex-col"
>
    <Reveal class="max-w-2xl">
        <Text variant="body-lg" class="max-w-2xl text-justify">
            I build products from the ground up for startups,
            niche developer tools, and systems that last!
            I&apos;m always trying to improve my understanding of computers
            and hardware, finding ways to shave off nanoseconds in critical
            systems, and building things that I&apos;ll only use once!
        </Text>
    </Reveal>
</Section>
