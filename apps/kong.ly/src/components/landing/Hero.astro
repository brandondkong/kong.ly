---
import { Image } from 'astro:assets';
import { sanityClient } from 'sanity:client';
import type { SanityImageRef } from '@kong/sanity';
import Text from '../common/Text.astro';
import SocialLink from '../common/SocialLink.astro';
import Portrait from '../../assets/imgs/portrait.png';
import Section from '../common/Section.astro';
import { GITHUB_LINK } from '../../lib/constants';
import { urlFor } from '../../lib/sanity';
import Reveal from '../common/Reveal.astro';

const profile = await sanityClient.fetch<{ avatar?: SanityImageRef } | null>(
    `*[_type == "linksPage"][0]{ avatar }`,
);
const avatarUrl = profile?.avatar
    ? urlFor(profile.avatar).width(336).height(336).url()
    : null;

const avatarClass =
    'aspect-square h-26 w-26 rounded-full object-cover md:h-auto md:w-26 xl:w-42';
---

<Section hideBorder paddingTop="hero" class="gap-section-gap flex flex-col">
    <div
        class="gap-element-gap flex flex-col-reverse items-start justify-between md:flex-row"
    >
        <Text variant="display" reveal aria-label="Brandon Kong">
            Brandon<br />Kong
        </Text>
        {
            avatarUrl ? (
                <Image
                    src={avatarUrl}
                    alt="Portrait of Brandon Kong"
                    class={avatarClass}
                    width={336}
                    height={336}
                    loading="eager"
                />
            ) : (
                <Image
                    src={Portrait}
                    alt="Portrait of Brandon Kong"
                    class={avatarClass}
                    width={336}
                    height={336}
                    loading="eager"
                />
            )
        }
    </div>
    <Reveal
        distance="256px"
        class="gap-content-gap flex flex-col items-start justify-between lg:flex-row"
    >
        <SocialLink
            text="brandondkong"
            icon="brands/github"
            cursorText="GitHub"
            href={GITHUB_LINK}
        />
        <Text variant="body-lg" class="max-w-xl indent-20 sm:text-justify">
            Hello, I&apos;m a software engineer based in Chicago focused on
            secure authentication&nbsp;infrastructure.
        </Text>
    </Reveal>
</Section>
