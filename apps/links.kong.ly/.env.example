# Umami analytics (optional). Leave UMAMI_WEBSITE_ID unset to disable tracking.
# Get the ID from your Umami dashboard: Settings → Websites → (your site).
UMAMI_WEBSITE_ID=

# Tracker script URL. Defaults to Umami Cloud when omitted.
# Set this to your instance's script URL if self-hosting, e.g.
# UMAMI_SRC=https://analytics.kong.ly/script.js
