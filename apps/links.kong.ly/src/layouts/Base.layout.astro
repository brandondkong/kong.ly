---
import { ClientRouter } from 'astro:transitions';
import Font from 'astro/components/Font.astro';
import SpeedInsights from '@vercel/speed-insights/astro';

import '../styles/global.css';
import Cursor from '../components/common/Cursor.astro';
import JsonLd from '../components/common/JsonLd.astro';
import Text from '../components/common/Text.astro';
import {
    SITE,
    STUDIO_LINK,
    GITHUB_LINK,
    LINKEDIN_LINK,
} from '../lib/constants';

interface Props {
    title?: string;
    description?: string;
    image?: string;
    type?: 'website' | 'profile';
}

const {
    title,
    description = SITE.description,
    image,
    type = 'website',
} = Astro.props;

const pageTitle = title ? `${title} — ${SITE.name}` : SITE.title;
const canonicalUrl = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = image ?? new URL('/og-default.png', SITE.url).href;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />

        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonicalUrl} />

        <meta property="og:type" content={type} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:locale" content={SITE.locale} />
        <meta property="og:site_name" content={SITE.name} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />

        <link
            rel="icon"
            type="image/png"
            sizes="16x16"
            href="/favicon-16x16.png"
        />
        <link
            rel="icon"
            type="image/png"
            sizes="32x32"
            href="/favicon-32x32.png"
        />
        <link rel="icon" href="/favicon.ico" sizes="32x32" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <link rel="manifest" href="/site.webmanifest" />
        <meta name="theme-color" content="#ffffff" />
        <Font cssVariable="--font-inter" />

        <JsonLd
            data={{
                '@context': 'https://schema.org',
                '@type': 'Person',
                name: SITE.name,
                url: STUDIO_LINK,
                description: SITE.description,
                sameAs: [GITHUB_LINK, LINKEDIN_LINK],
            }}
        />
        <ClientRouter />
        <noscript>
            <style>
                [data-reveal] {
                    visibility: visible;
                }
                [data-reveal-fade] {
                    opacity: 1;
                    translate: none;
                }
            </style>
        </noscript>
    </head>
    <body>
        <a
            href="#main"
            class="focus:bg-foreground focus:text-background sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium"
        >
            Skip to main content
        </a>
        <div class="flex min-h-screen flex-col">
            <main
                id="main"
                class="px-section-x relative z-10 flex w-full flex-1 justify-center py-16 md:py-24"
            >
                <div class="flex w-full max-w-xl flex-col">
                    <slot />
                </div>
            </main>
            <footer class="px-section-x pb-footer-bottom-sm pt-8">
                <div
                    class="mx-auto flex w-full max-w-xl flex-col items-center gap-2"
                >
                    <a
                        href={STUDIO_LINK}
                        class="hover:text-foreground text-muted transition-colors"
                    >
                        <Text variant="normal">kong.ly</Text>
                    </a>
                    <Text variant="label" class="text-muted">
                        © {year} &nbsp;
                        {SITE.name}
                    </Text>
                </div>
            </footer>
        </div>
        <Cursor />
        <SpeedInsights />


    </body>
</html>
