---
import Text from './Text.astro';
import { Icon } from 'astro-icon/components';

interface NavItem {
    label: string;
    href: string;
}

const navItems: NavItem[] = [
    { label: 'Games', href: '/#games' },
    { label: 'Studio', href: '/#about' },
    { label: 'Careers', href: '/#careers' },
    { label: 'Contact', href: '/#contact' },
];
---

<header class="border-border bg-background border-b">
    <nav
        class="px-section-x sm:px-section-x-sm mx-auto flex h-16 max-w-480 items-center justify-between"
        aria-label="Primary"
    >
        <a href="/" class="flex items-center gap-2" aria-label="Home">
            <Text variant="heading" class="text-xl font-semibold">
                Kong&apos;s Games
            </Text>
        </a>

        <button
            type="button"
            id="nav-toggle"
            class="text-foreground -mr-2 inline-flex h-10 w-10 items-center justify-center md:hidden"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="nav-menu"
        >
            <Icon name="menu" class="h-6 w-6" aria-hidden="true" />
        </button>

        <ul class="hidden items-center gap-8 md:flex">
            {
                navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="hover:text-muted text-foreground text-sm transition-colors"
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </nav>

    <!-- Mobile menu -->
    <div
        id="nav-menu"
        class="border-border bg-background hidden border-t md:hidden"
    >
        <ul class="px-section-x flex flex-col gap-1 py-4">
            {
                navItems.map((item) => (
                    <li>
                        <a
                            href={item.href}
                            class="hover:bg-surface block rounded-md px-3 py-2 text-base transition-colors"
                        >
                            {item.label}
                        </a>
                    </li>
                ))
            }
        </ul>
    </div>
</header>

<script>
    function setupNav() {
        const toggle = document.getElementById('nav-toggle');
        const menu = document.getElementById('nav-menu');
        if (!toggle || !menu) return;

        const closeMenu = () => {
            menu.classList.add('hidden');
            toggle.setAttribute('aria-expanded', 'false');
        };

        toggle.addEventListener('click', () => {
            const isOpen = !menu.classList.contains('hidden');
            if (isOpen) {
                closeMenu();
            } else {
                menu.classList.remove('hidden');
                toggle.setAttribute('aria-expanded', 'true');
            }
        });

        menu.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
        });
    }

    setupNav();
    document.addEventListener('astro:page-load', setupNav);
</script>
